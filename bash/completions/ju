# Defines _clap_reassemble_words and _clap_trim_completions (generic clap
# plumbing, not just-specific — ju's completer below reuses them via
# bash's dynamic scoping) plus _clap_complete_just itself. Evaluated
# fresh here rather than copied, so ju's completion protocol can't drift
# from whatever `just` version is actually installed.
eval "$(JUST_COMPLETE=bash just)"

# just's own bash completion (bash/completions/just, generated by
# `just --completions bash`) always shells out to the literal `just`
# binary with COMP_WORDS as-is — it has no idea `ju` means
# `just --justfile .private-scratch/justfile --working-directory .`. Left
# alone, `ju <Tab>` would complete recipes from a project's regular
# justfile (or nothing) instead of .private-scratch/justfile. So this
# reimplements the same dynamic-completion protocol but injects ju's
# flags into the argv sent to `just`, shifting _CLAP_COMPLETE_INDEX by
# the 4 injected words (--justfile, its value, --working-directory, its
# value).
_clap_complete_ju() {
    local IFS=$'\013'
    local _CLAP_COMPLETE_INDEX=${COMP_CWORD}
    local _CLAP_COMPLETE_COMP_TYPE=${COMP_TYPE}
    if compopt +o nospace 2> /dev/null; then
        local _CLAP_COMPLETE_SPACE=false
    else
        local _CLAP_COMPLETE_SPACE=true
    fi
    local words=("${COMP_WORDS[@]}")
    _clap_reassemble_words
    _CLAP_COMPLETE_INDEX=$((_CLAP_COMPLETE_INDEX + 4))
    words=("${words[0]}" --justfile .private-scratch/justfile --working-directory . "${words[@]:1}")
    COMPREPLY=( $( \
        _CLAP_IFS="$IFS" \
        _CLAP_COMPLETE_INDEX="$_CLAP_COMPLETE_INDEX" \
        _CLAP_COMPLETE_COMP_TYPE="$_CLAP_COMPLETE_COMP_TYPE" \
        _CLAP_COMPLETE_SPACE="$_CLAP_COMPLETE_SPACE" \
        JUST_COMPLETE="bash" \
        just -- "${words[@]}" \
    ) )
    if [[ $? != 0 ]]; then
        unset COMPREPLY
    elif [[ $_CLAP_COMPLETE_SPACE == false ]] && [[ "${COMPREPLY-}" =~ [=/:]$ ]]; then
        compopt -o nospace
    fi
    _clap_trim_completions
}

if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -o nospace -o bashdefault -o nosort -F _clap_complete_ju ju
else
    complete -o nospace -o bashdefault -F _clap_complete_ju ju
fi
