# Sourced by ~/.bashrc; kept separate so the distro-default .bashrc stays untouched.

# User-local binaries (e.g. Claude Code's native installer) live here; not
# guaranteed to already be on PATH in every shell.
export PATH="$HOME/.local/bin:$PATH"

alias c='code -g'
alias cw='cd ${workspaceFolder}'
# Personal justfile shortcuts (see project-init's templates/justfile).
# Not named `justfile`, so plain `just` won't auto-discover it — must be
# invoked from the project root.
alias ju='just --justfile .private-scratch/justfile --working-directory .'
alias ..='cd ..'
alias ...='cd ../..'
alias log='script /tmp/$(date +%m%d_%H%M_%S).log -c'

# When using tab completion, do not add a backslash
shopt -s direxpand

# cd by typing a directory name alone
shopt -s autocd

# Up/down arrow: search history by what's already typed as a prefix
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

# Sync history across concurrently open terminals instead of only at shell exit
PROMPT_COMMAND="history -a; history -c; history -r"

# `code` CLI only exists when a VS Code client is actually connected.
if command -v code >/dev/null 2>&1; then
  export EDITOR='code --wait'
  export VISUAL='code --wait'
else
  export EDITOR='vi'
  export VISUAL='vi'
fi

# fzf key bindings (Ctrl+T, Ctrl+R, Alt+C) and completion, if installed.
# Not installed by this repo — see README for platform-specific instructions.
# `--bash` needs fzf 0.48+; older installs print an "unknown option" error
# to stderr and produce no stdout, so guard on actual output to stay a
# silent no-op instead of spamming every new shell with that error.
if command -v fzf >/dev/null 2>&1; then
  fzf_init="$(fzf --bash 2>/dev/null)" && [ -n "$fzf_init" ] && eval "$fzf_init"
  unset fzf_init
fi

[ -f "$HOME/.bash_aliases.local" ] && . "$HOME/.bash_aliases.local"
