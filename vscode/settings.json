{
  "cmake.configureOnEdit": false,
  "cmake.configureOnOpen": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.fontFamily": "Consolas, Meiryo UI, 'Courier New', monospace",
  "editor.fontSize": 13,
  "editor.formatOnSave": true,
  // Show jump counts for vscode-neovim motions like 5j / 12k
  "editor.lineNumbers": "relative",
  "editor.renderWhitespace": "all",
  "editor.snippetSuggestions": "top",
  // When a file is selected,
  // the file tree does not move the focus location
  "explorer.autoReveal": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  // Recommended by vscode-neovim: run it in its own extension host so
  // other extensions can't delay key handling
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  // Show .git/
  "files.exclude": {
    "**/.git": false
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  // Mirrors search.exclude (plus .git internals); keep the two in sync
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/build*/**": true,
    "**/target/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.venv/**": true,
    "**/venv/**": true
  },
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.detectSubmodulesLimit": 100,
  "git.suggestSmartCommit": false,
  "gitlens.views.stashes.files.layout": "list",
  // Run vscode-neovim next to the files (WSL, SSH, or local) so it uses
  // that side's nvim and nvim/init.lua, with no per-machine useWSL/path
  "remote.extensionKind": {
    "asvetliakov.vscode-neovim": [
      "workspace"
    ]
  },
  "ruff.lint.ignore": [
    "COM812", // trailing comma conflicts with formatter
    "CPY", // this project does not use copyright header comments
    "D203", // 1 blank line required before class docstring (conflicts with D211)
    "D213" // multi-line docstring summary should start at the second line (conflicts with D212)
  ],
  "ruff.lint.select": [
    "ALL"
  ],
  "search.defaultViewMode": "tree",
  // Mirrored in files.watcherExclude; keep the two in sync
  "search.exclude": {
    "**/.git": true,
    "**/build*": true,
    "**/target": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.venv": true,
    "**/venv": true
  },
  "search.showLineNumbers": true,
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  // Set environment variables
  "terminal.integrated.env.linux": {
    "workspaceFolder": "${workspaceFolder}"
  },
  "terminal.integrated.scrollback": 5000,
  "vscode-neovim.compositeKeys": {
    "jk": {
      "command": "vscode-neovim.escape"
    }
  },
  // vscode-neovim: in insert mode keep the default Ctrl key list minus
  // "c", which is also checked in visual mode and would otherwise turn
  // Ctrl+C on a mouse selection into Escape; hand every Ctrl key in
  // normal/visual mode to VS Code (nvim/init.lua maps Alt stand-ins)
  "vscode-neovim.ctrlKeysForInsertMode": [
    "a",
    "d",
    "h",
    "j",
    "m",
    "o",
    "r",
    "t",
    "u",
    "w"
  ],
  "vscode-neovim.ctrlKeysForNormalMode": [],
  "window.zoomLevel": 1.8,
  "workbench.colorCustomizations": {
    // Color of Selected line
    "editor.lineHighlightBackground": "#303030"
  },
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.enablePreview": false,
  // Open tabs on multiple lines
  "workbench.editor.wrapTabs": true,
  "workbench.startupEditor": "none",
  "[markdown]": {
    // Markdown disables quick suggestions in plain text by default, which
    // also suppresses snippet auto-popup while typing prose
    "editor.quickSuggestions": {
      "other": true
    },
    // Keep trailing two-space hard breaks, matching the pre-commit hook
    "files.trimTrailingWhitespace": false
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  }
  // --- machine-local settings below — never commit these ---
}
