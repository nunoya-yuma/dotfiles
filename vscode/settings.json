{
  "cmake.configureOnEdit": false,
  "cmake.configureOnOpen": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.fontFamily": "Consolas, Meiryo UI, 'Courier New', monospace",
  "editor.fontSize": 13,
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "all",
  "editor.snippetSuggestions": "top",
  // Markdown disables quick suggestions in plain text by default, which
  // also suppresses snippet auto-popup while typing prose
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": true
    }
  },
  // When a file is selected,
  // the file tree does not move the focus location
  "explorer.autoReveal": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  // Show .git/
  "files.exclude": {
    "**/.git": false
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.detectSubmodulesLimit": 100,
  "git.suggestSmartCommit": false,
  "gitlens.views.stashes.files.layout": "list",
  "ruff.lint.select": [
    "ALL"
  ],
  "ruff.lint.ignore": [
    "COM812", // trailing comma conflicts with formatter
    "CPY", // this project does not use copyright header comments
    "D203", // 1 blank line required before class docstring (conflicts with D211)
    "D213" // multi-line docstring summary should start at the second line (conflicts with D212)
  ],
  "search.exclude": {
    "**/.git": true,
    "**/build*": true
  },
  "search.defaultViewMode": "tree",
  "search.showLineNumbers": true,
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  // Set environment variables
  "terminal.integrated.env.linux": {
    "workspaceFolder": "${workspaceFolder}"
  },
  "terminal.integrated.scrollback": 5000,
  "workbench.colorCustomizations": {
    // Color of Selected line
    "editor.lineHighlightBackground": "#303030"
  },
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.enablePreview": false,
  // Open tabs on multiple lines
  "workbench.editor.wrapTabs": true,
  "workbench.startupEditor": "none",
  "window.zoomLevel": 1.8
  // --- machine-local settings below — never commit these ---
}
