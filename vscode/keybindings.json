// install.sh links this into the local user scope (Linux or native
// Windows). VS Code has no remote-scoped keybindings, so a client that
// hasn't run install.sh (e.g. a browser-based Codespace) needs it pasted
// manually into the Keyboard Shortcuts (JSON) editor — see README.
[
    // ctrl + tab and ctrl + shift + tab -> move tab
    {
        "key": "ctrl+tab",
        "command": "workbench.action.nextEditor",
    },
    {
        "key": "ctrl+pageDown",
        "command": "-workbench.action.nextEditor",
    },
    {
        "key": "ctrl+shift+tab",
        "command": "workbench.action.previousEditor",
    },
    {
        "key": "ctrl+pageup",
        "command": "-workbench.action.previousEditor",
    },
    // ctrl + \ -> split file
    {
        "key": "ctrl+oem_5",
        "command": "-workbench.action.splitEditor"
    },
    {
        "key": "ctrl+oem_5",
        "command": "workbench.action.splitEditorInGroup",
        "when": "activeEditorCanSplitInGroup"
    },
    {
        "key": "ctrl+k ctrl+shift+oem_5",
        "command": "-workbench.action.splitEditorInGroup",
        "when": "activeEditorCanSplitInGroup"
    },
    {
        "key": "ctrl+oem_5",
        "command": "workbench.action.joinEditorInGroup",
        "when": "sideBySideEditorActive"
    },
    {
        "key": "ctrl+k ctrl+shift+oem_5",
        "command": "-workbench.action.joinEditorInGroup",
        "when": "sideBySideEditorActive"
    },
    // Move file to other editor group
    {
        "key": "ctrl+k right",
        "command": "-workbench.action.moveActiveEditorGroupRight"
    },
    {
        "key": "ctrl+k right",
        "command": "-views.moveViewRight",
        "when": "focusedView != ''"
    },
    {
        "key": "ctrl+k right",
        "command": "workbench.action.moveEditorToRightGroup"
    },
    {
        "key": "ctrl+k left",
        "command": "workbench.action.moveEditorToLeftGroup"
    },
    {
        "key": "ctrl+k left",
        "command": "-workbench.action.moveActiveEditorGroupLeft"
    },
    {
        "key": "ctrl+k left",
        "command": "-views.moveViewLeft",
        "when": "focusedView != ''"
    },
    // Remove ctrl enter to generate code(Github Copilot)
    {
        "key": "ctrl+enter",
        "command": "-github.copilot.generate",
        "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused"
    },
    // Maximize the terminal window
    {
        "key": "ctrl+k ctrl+m",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "panelFocus"
    },
    // Focus the terminal accessible view
    {
        "key": "ctrl+shift+l",
        "command": "editor.action.accessibleView",
        "when": "terminalFocus"
    },
    // vscode-neovim maps the physical US "[" key to Escape; on a JIS
    // keyboard that key is "@", which shadows Ctrl+@ (toggle terminal)
    {
        "key": "ctrl+[BracketLeft]",
        "command": "-vscode-neovim.escape"
    },
    // vscode-neovim doesn't forward Alt combos; send these to Neovim,
    // where nvim/init.lua maps them to the Ctrl actions VS Code keeps
    {
        "key": "alt+d",
        "command": "vscode-neovim.send",
        "args": "<M-d>",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert"
    },
    {
        "key": "alt+u",
        "command": "vscode-neovim.send",
        "args": "<M-u>",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert"
    },
    {
        "key": "alt+v",
        "command": "vscode-neovim.send",
        "args": "<M-v>",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert"
    },
    {
        "key": "alt+r",
        "command": "vscode-neovim.send",
        "args": "<M-r>",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert"
    },
    {
        "key": "alt+a",
        "command": "vscode-neovim.send",
        "args": "<M-a>",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert"
    },
    {
        "key": "alt+x",
        "command": "vscode-neovim.send",
        "args": "<M-x>",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert"
    }
]
