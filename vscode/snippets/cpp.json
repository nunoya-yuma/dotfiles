{
    "enum definition": {
        "prefix": "enum",
        "body": [
            "typedef enum {",
            "    ${1:ENUM_VALUE_1},",
            "} ${2:EnumName_t};"
        ],
        "description": "Enum definition"
    },
    "main function": {
        "prefix": "main",
        "body": [
            "#include <stdio.h>",
            "",
            "int main(int argc, char *argv[]) {",
            "    $1",
            "    return 0;",
            "}"
        ],
        "description": "Main function template"
    },
    "printf normal": {
        "prefix": "printf",
        "body": [
            "printf(\"$1\\n\"$2);"
        ],
        "description": "print normal"
    },
    "print normal(cout)": {
        "prefix": "cout",
        "body": [
            "std::cout << $1 << std::endl;",
        ],
        "description": "Log output to console"
    },
    "print debug": {
        "prefix": "printf",
        "body": [
            "printf(\"\\033[35m\");",
            "printf(\"[DEBUG]%s:%d $1\\n\", __FILE__, __LINE__$2);",
            "printf(\"\\033[0m\");"
        ],
        "description": "print debug"
    },
    "print custom log": {
        "prefix": "printf",
        "body": [
            "printf(\"[NN] %s:%d$1\\n\", __FILE__, __LINE__$2);"
        ],
        "description": "print custom log"
    },
    "typedef(struct)": {
        "prefix": "typedef",
        "body": [
            "typedef struct",
            "{",
            "\t${1:type_t} ${2:m_name};",
            "} ${3:Struct_t};",
        ],
        "description": "Main function template"
    },
}
