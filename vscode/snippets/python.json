{
    "add/new/cell": {
        "prefix": "cell",
        "body": "# %%",
        "description": "Code snippet to add a new cell"
    },
    "async/def": {
        "prefix": "async def",
        "body": [
            "async def ${1:funcname}(${2:parameter_list}):",
            "\t${3:pass}"
        ],
        "description": "Code snippet for an async statement"
    },
    "async/for": {
        "prefix": "async for",
        "body": [
            "async for ${1:target} in ${2:iter}:",
            "\t${3:block}"
        ],
        "description": "Code snippet for an async for statement"
    },
    "async/for/else": {
        "prefix": "async for",
        "body": [
            "async for ${1:target} in ${2:iter}:",
            "\t${3:block}",
            "else:",
            "\t${4:block}"
        ],
        "description": "Code snippet for an async for statement with else"
    },
    "async/with": {
        "prefix": "async with",
        "body": [
            "async with ${1:expr} as ${2:var}:",
            "\t${3:block}"
        ],
        "description": "Code snippet for an async with statement"
    },
    "class": {
        "prefix": "class",
        "body": [
            "class ${1:classname}(${2:object}):",
            "\t${3:pass}"
        ],
        "description": "Code snippet for a class definition"
    },
    "class(exception)": {
        "prefix": "class",
        "body": [
            "class ${1:CustomError}(Exception):",
            "\t${2:pass}"
        ],
        "description": "Code snippet for a custom exception class"
    },
    "dataclass": {
        "prefix": "dataclass",
        "body": [
            "@dataclass",
            "class ${1:ClassName}:",
            "\t${2:field_name}: ${3:type}"
        ],
        "description": "Code snippet for a dataclass definition"
    },
    "def": {
        "prefix": "def",
        "body": [
            "def ${1:funcname}(${2:parameter_list}):",
            "\t${3:pass}"
        ],
        "description": "Code snippet for a function definition"
    },
    "def(abstract class function)": {
        "prefix": "def",
        "body": [
            "def ${1:funcname}(self, ${2:parameter_list}):",
            "\traise NotImplementedError"
        ],
        "description": "Code snippet for an abstract class method"
    },
    "def(class function)": {
        "prefix": "def",
        "body": [
            "def ${1:funcname}(self, ${2:parameter_list}):",
            "\t${3:pass}"
        ],
        "description": "Code snippet for a class method"
    },
    "def(init)": {
        "prefix": "def",
        "body": [
            "def __init__(self, ${1:parameter_list}):",
            "\t${2:pass}"
        ],
        "description": "Code snippet for an __init__ method"
    },
    "def(pytest fixture)": {
        "prefix": "fixture",
        "body": [
            "@pytest.fixture",
            "def ${1:name}():",
            "\t${2:yield} $3"
        ],
        "description": "Code snippet for a pytest fixture"
    },
    "def(static class method)": {
        "prefix": "staticmethod",
        "body": [
            "@staticmethod",
            "def ${1:funcname}(${2:parameter_list}):",
            "\t${3:pass}"
        ],
        "description": "Code snippet for a static class method"
    },
    "def(test)": {
        "prefix": "def",
        "body": [
            "def test_${1:name}():",
            "\t${2:assert} $3"
        ],
        "description": "Code snippet for a pytest test function"
    },
    "elif": {
        "prefix": "elif",
        "body": [
            "elif ${1:expression}:",
            "\t${2:pass}"
        ],
        "description": "Code snippet for an elif"
    },
    "else": {
        "prefix": "else",
        "body": [
            "else:",
            "\t${1:pass}"
        ],
        "description": "Code snippet for an else"
    },
    "f-string": {
        "prefix": "fstr",
        "body": [
            "f\"$1\""
        ],
        "description": "Code snippet for an f-string"
    },
    "for": {
        "prefix": "for",
        "body": [
            "for ${1:target_list} in ${2:expression_list}:",
            "\t${3:pass}"
        ],
        "description": "Code snippet for a for loop"
    },
    "for/else": {
        "prefix": "for",
        "body": [
            "for ${1:target_list} in ${2:expression_list}:",
            "\t${3:pass}",
            "else:",
            "\t${4:pass}"
        ],
        "description": "Code snippet for a for loop with else"
    },
    "if": {
        "prefix": "if",
        "body": [
            "if ${1:expression}:",
            "\t${2:pass}"
        ],
        "description": "Code snippet for an if statement"
    },
    "if(main)": {
        "prefix": "__main__",
        "body": [
            "if __name__ == \"__main__\":",
            "    ${1:pass}"
        ],
        "description": "Code snippet for a `if __name__ == \"__main__\": ...` block"
    },
    "if(type_checking)": {
        "prefix": "if",
        "body": [
            "if TYPE_CHECKING:",
            "\t${1:pass}"
        ],
        "description": "Code snippet for a TYPE_CHECKING guard"
    },
    "if/else": {
        "prefix": "if",
        "body": [
            "if ${1:condition}:",
            "\t${2:pass}",
            "else:",
            "\t${3:pass}"
        ],
        "description": "Code snippet for an if statement with else"
    },
    "ipdb": {
        "prefix": "ipdb",
        "body": "import ipdb; ipdb.set_trace()",
        "description": "Code snippet for ipdb debug"
    },
    "lambda": {
        "prefix": "lambda",
        "body": [
            "lambda ${1:parameter_list}: ${2:expression}"
        ],
        "description": "Code snippet for a lambda statement"
    },
    "logger": {
        "prefix": "logger",
        "body": [
            "logger = logging.getLogger(__name__)"
        ],
        "description": "Code snippet for a module-level logger"
    },
    "mark/markdown": {
        "prefix": "markdown",
        "body": "# %% [markdown]",
        "description": "Code snippet to add a new markdown cell"
    },
    "pdb": {
        "prefix": "pdb",
        "body": "import pdb; pdb.set_trace()",
        "description": "Code snippet for pdb debug"
    },
    "print": {
        "prefix": "print",
        "body": [
            "print(${1:expression})"
        ],
        "description": "Code snippet for an print"
    },
    "pudb": {
        "prefix": "pudb",
        "body": "import pudb; pudb.set_trace()",
        "description": "Code snippet for pudb debug"
    },
    "try/except": {
        "prefix": "try",
        "body": [
            "try:",
            "\t${1:pass}",
            "except ${2:expression} as ${3:identifier}:",
            "\t${4:pass}"
        ],
        "description": "Code snippet for a try/except statement"
    },
    "try/except/else": {
        "prefix": "try",
        "body": [
            "try:",
            "\t${1:pass}",
            "except ${2:expression} as ${3:identifier}:",
            "\t${4:pass}",
            "else:",
            "\t${5:pass}"
        ],
        "description": "Code snippet for a try/except/else statement"
    },
    "try/except/else/finally": {
        "prefix": "try",
        "body": [
            "try:",
            "\t${1:pass}",
            "except ${2:expression} as ${3:identifier}:",
            "\t${4:pass}",
            "else:",
            "\t${5:pass}",
            "finally:",
            "\t${6:pass}"
        ],
        "description": "Code snippet for a try/except/else/finally statement"
    },
    "try/except/finally": {
        "prefix": "try",
        "body": [
            "try:",
            "\t${1:pass}",
            "except ${2:expression} as ${3:identifier}:",
            "\t${4:pass}",
            "finally:",
            "\t${5:pass}"
        ],
        "description": "Code snippet for a try/except/finally statement"
    },
    "try/finally": {
        "prefix": "try",
        "body": [
            "try:",
            "\t${1:pass}",
            "finally:",
            "\t${2:pass}"
        ],
        "description": "Code snippet for a try/finally statement"
    },
    "while": {
        "prefix": "while",
        "body": [
            "while ${1:expression}:",
            "\t${2:pass}"
        ],
        "description": "Code snippet for a while loop"
    },
    "while/else": {
        "prefix": "while",
        "body": [
            "while ${1:expression}:",
            "\t${2:pass}",
            "else:",
            "\t${3:pass}"
        ],
        "description": "Code snippet for a while loop with else"
    },
    "with": {
        "prefix": "with",
        "body": [
            "with ${1:expression} as ${2:target}:",
            "\t${3:pass}"
        ],
        "description": "Code snippet for a with statement"
    }
}
